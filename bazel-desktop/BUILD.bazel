load("@rules_compose_preview//:defs.bzl", "compose_preview")
load("@rules_compose_preview//:tool.bzl", "compose_preview_cli")
load("@rules_java//java:defs.bzl", "java_library")
load("@rules_kotlin//kotlin:core.bzl", "define_kt_toolchain", "kt_compiler_plugin")
load("@rules_kotlin//kotlin:jvm.bzl", "kt_jvm_library")
load(":compose_preview.bzl", "bundle_preview", "runtime_classpath")

# CMP dependencies contain JVM 11 bytecode. Match the declared Java 17 toolchain.
define_kt_toolchain(
    name = "kotlin_toolchain",
    jvm_target = "17",
)

# Compose compiler plugin (the Kotlin-bundled one, post-K2 plugin model).
kt_compiler_plugin(
    name = "compose_compiler_plugin",
    id = "androidx.compose.compiler.plugins.kotlin",
    target_embedded_compiler = True,
    deps = ["@maven//:org_jetbrains_kotlin_kotlin_compose_compiler_plugin_embeddable"],
)

# The consumer module: a plain JVM library compiling the Compose-Desktop
# `@Preview`. No rules_android — this is the whole point of the desktop sample.
kt_jvm_library(
    name = "app",
    srcs = glob(["app/src/main/kotlin/**/*.kt"]),
    plugins = [":compose_compiler_plugin"],
    deps = [
        "@maven//:org_jetbrains_compose_foundation_foundation_desktop",
        "@maven//:org_jetbrains_compose_material3_material3_desktop",
        "@maven//:org_jetbrains_compose_runtime_runtime_desktop",
        "@maven//:org_jetbrains_compose_ui_ui_desktop",
        "@maven//:org_jetbrains_compose_ui_ui_tooling_preview_desktop",
    ],
)

# The shared portable-bundle producer, built by the repo's Gradle as a single
# runnable jar and copied next to this BUILD file:
#
#   ./gradlew :bundle-producer:uberJar
#   cp ../bundle-producer/build/libs/bundle-producer-all.jar bazel-desktop/
#
# Git-ignored (see .gitignore) — it's a build artifact, not source.
exports_files(["bundle-producer-all.jar"])

# Packs a portable `compose-preview` bundle (`preview_bundle.png`, a PNG+ZIP
# polyglot) from the library's compiled output, recovering Maven coordinates +
# sha256 from the pinned `maven_install.json` (`producer = "bazel"`,
# `resolution = "coordinates"`). CI builds this and uploads it as an artifact.
bundle_preview(
    name = "preview_bundle",
    maven_install = "maven_install.json",
    module = ":app",
    module_path = "//:app",
    previews = [
        "GreetingKt.Greeting=com.example.bazeldesktop.GreetingKt#Greeting@app/src/main/kotlin/com/example/bazeldesktop/Greeting.kt",
    ],
)

runtime_classpath(
    name = "runtime_classpath",
    module = ":app",
)

# Generated module bytecode must be discovered alongside the source-backed preview.
genrule(
    name = "generated_preview",
    outs = ["GeneratedGreeting.kt"],
    cmd = "cat > $@ <<'KOTLIN'\npackage com.example.bazeldesktop\nimport androidx.compose.runtime.Composable\nimport androidx.compose.ui.tooling.preview.Preview\n@Composable @Preview(widthDp = 320, heightDp = 180, showBackground = true, backgroundColor = 0xFFFFFFFF) fun GeneratedGreeting() { RuntimeGreeting() }\nKOTLIN",
)

java_library(
    name = "runtime_message",
    srcs = ["app/src/runtime/java/com/example/bazeldesktop/RuntimeMessage.java"],
    resource_strip_prefix = "app/src/runtime/resources",
    resources = ["app/src/runtime/resources/runtime-message.txt"],
)

kt_jvm_library(
    name = "dependency_ui",
    srcs = glob(["app/src/dependency/kotlin/**/*.kt"]),
    plugins = [":compose_compiler_plugin"],
    deps = [
        "@maven//:org_jetbrains_compose_foundation_foundation_desktop",
        "@maven//:org_jetbrains_compose_runtime_runtime_desktop",
        "@maven//:org_jetbrains_compose_ui_ui_tooling_preview_desktop",
    ],
)

# Separate from the portable-bundle fixture: reflection is deliberately opaque to
# bundle minimization, but the aspect must carry the whole configured runtime.
kt_jvm_library(
    name = "aspect_app",
    srcs = glob(["app/src/aspect/kotlin/**/*.kt"]) + [":generated_preview"],
    plugins = [":compose_compiler_plugin"],
    runtime_deps = [
        ":dependency_ui",
        ":runtime_message",
    ],
    deps = [
        "@maven//:org_jetbrains_compose_foundation_foundation_desktop",
        "@maven//:org_jetbrains_compose_material3_material3_desktop",
        "@maven//:org_jetbrains_compose_runtime_runtime_desktop",
        "@maven//:org_jetbrains_compose_ui_ui_desktop",
        "@maven//:org_jetbrains_compose_ui_ui_tooling_preview_desktop",
    ],
)

# Stage the CLI distribution into .compose-preview/cli before using native targets.
# Consumers can instead use a checksum-pinned CLI repository (see rules README).
compose_preview_cli(
    name = "preview_cli",
    files = glob([".compose-preview/cli/**"]),
    launcher = ".compose-preview/cli/bin/compose-preview",
)

compose_preview(
    name = "ui-preview",
    srcs = glob(["app/src/aspect/kotlin/**/*.kt"]) + [":generated_preview"],
    cli = ":preview_cli",
    maven_install = ":maven_install.json",
    module = ":aspect_app",
    outputs = [
        "png",
        "bundle",
    ],
)
