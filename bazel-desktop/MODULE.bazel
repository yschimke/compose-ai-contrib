# Bazel sample — Compose **Desktop** preview bundle.
#
# Unlike the sibling `bazel-apk/` (Android) sample, this compiles a Compose
# `@Preview` with a plain `kt_jvm_library` and **no `rules_android`** — so it
# avoids the Android toolchain entirely (no AAPT2/dexer, no rules_android Go
# tools) and builds a portable preview bundle that CI can publish as a
# downloadable artifact. See `BUILD.bazel` and `../docs/portable-bundles.md`.

module(
    name = "compose_ai_tools_bazel_desktop_sample",
    version = "0.0.0",
)

bazel_dep(name = "rules_compose_preview", version = "0.1.0-rc.15")

# Independent, immutable rule module; preview CLI remains separately staged/pinned.
git_override(
    module_name = "rules_compose_preview",
    commit = "e1aa6851453f6ed3caea25a5e66f31267d6efe33",
    remote = "https://github.com/yschimke/compose-preview-bazel.git",
)

bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "rules_jvm_external", version = "7.2")

# Kotlin and the Compose compiler plugin are versioned together.
bazel_dep(name = "rules_kotlin", version = "2.4.21")

# Explicit JavaInfo dependency and Android rules compatible with Bazel 9.
bazel_dep(name = "rules_java", version = "9.9.0")
bazel_dep(name = "rules_android", version = "0.8.0")

register_toolchains("//:kotlin_toolchain")

# Maven graph for Compose Desktop, pinned to a checked-in lock file so CI
# replays a deterministic resolution. Regenerate with `bazel run @maven//:pin`.
maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    name = "maven",
    artifacts = [
        # Kotlin compose compiler plugin — must match the Kotlin compiler
        # rules_kotlin 2.4.20 bundles (2.4.20); it's versioned in lockstep with
        # Kotlin and refuses to load against a different compiler version.
        "org.jetbrains.kotlin:kotlin-compose-compiler-plugin-embeddable:2.4.20",
        # Compose Multiplatform desktop runtime (the same set the Amper desktop
        # fixture pulls via `$compose.desktop.currentOs` + `$compose.material3`).
        "org.jetbrains.compose.runtime:runtime-desktop:1.12.2",
        "org.jetbrains.compose.foundation:foundation-desktop:1.12.2",
        "org.jetbrains.compose.material3:material3-desktop:1.9.0",
        "org.jetbrains.compose.ui:ui-desktop:1.12.2",
        "org.jetbrains.compose.ui:ui-tooling-preview-desktop:1.12.2",
    ],
    fail_if_repin_required = True,
    known_contributing_modules = ["protobuf"],
    lock_file = "//:maven_install.json",
    repositories = [
        "https://maven.google.com",
        "https://repo1.maven.org/maven2",
    ],
    # Force declared versions so any conflicting transitive strict pins resolve
    # to one version instead of failing resolution.
    version_conflict_policy = "pinned",
)
use_repo(maven, "maven")
